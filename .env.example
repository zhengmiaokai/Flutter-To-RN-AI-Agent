# ── Global LLM connection (also the default for any unrouted task) ──
OPENAI_API_KEY="your-api-key"
OPENAI_BASE_URL="https://api.deepseek.com"

# ── 按任务模型路由（可选）──
# MODEL_ROUTES='{
#   "convert":       {"model": "deepseek-v4-pro", "base_url": "https://api.deepseek.com", "api_key": "sk-..."},
#   "reflect":       {"model": "deepseek-v4-flash", "fallback_model": "deepseek-v4-pro"},
#   "verify_fix":    {"model": "deepseek-pro"}
# }'

# ── Harness 可选开关 ──
# TOKEN_BUDGET=0        # 硬性 token 预算上限（0 = 不限）
# CACHE_ENABLED=true    # 响应缓存开关
# CACHE_TTL_HOURS=24    # 缓存 TTL（小时）
# MEMORY_ENABLED=true   # 跨运行记忆开关
